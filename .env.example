# copernicus-ems settings. Copy to .env (never committed) and fill in:
#   cp .env.example .env
# The library reads these from the environment: export them, load the file
# in your shell (set -a; . ./.env; set +a) or give it to docker compose
# (env_file: .env). Values with spaces go between quotes.

# --- Dove stanno i dati (where the data lives) -----------------------------
# The data root shared by the agent-engineering-studio libraries and Limen:
# each one keeps its files in its own folder under it, this one in
# $DATA_ROOT/copernicus-ems. Everything goes there and is read from there:
# the activation list and details and the GeoJSON layers (copernicus-ems
# init, fetch), the Sentinel-1 backscatter (pairs) and the MCP exports.
# A relative path is relative to the directory you run from.
# Unset: ~/.cache/copernicus-ems (or $XDG_CACHE_HOME/copernicus-ems).
# A compose file mounts ${DATA_ROOT:-./data}/copernicus-ems.
#DATA_ROOT=./data

# --- Copernicus Data Space (extra copernicus-ems[cdse]) --------------------
# Only for the Sentinel-1 backscatter (copernicus-ems pairs): an OAuth
# client (Dashboard -> User Settings -> OAuth clients on
# https://dataspace.copernicus.eu). Treat the secret as a password.
# Or a JSON file {"client_id": …, "client_secret": …}.
#CDSE_CLIENT_ID=
#CDSE_CLIENT_SECRET=
#CDSE_CREDENTIALS_FILE=./secrets/cdse.json

# --- MCP server (extra copernicus-ems[mcp]) --------------------------------
#COPERNICUS_EMS_MCP_TRANSPORT=streamable-http
#COPERNICUS_EMS_MCP_HOST=127.0.0.1
#COPERNICUS_EMS_MCP_PORT=8768
#COPERNICUS_EMS_MCP_ALLOWED_HOSTS=localhost:*
